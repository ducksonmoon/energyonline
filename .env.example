# Copy to .env and fill in real values before running `npx prisma db push` / `npm run dev`.

# SQLite file used by Prisma (see prisma/schema.prisma + prisma.config.ts).
DATABASE_URL="file:./dev.db"

# Signing key for admin session JWTs. Use a long random string, e.g. `openssl rand -base64 32`.
SESSION_SECRET="change-me"

# Seeded via prisma/seed.ts — the single admin login for /admin.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Optional: leave blank to disable. Only loaded on the public storefront, never in /admin.
# GA4 Measurement ID from analytics.google.com (looks like G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Clarity Project ID from clarity.microsoft.com (a short alphanumeric code).
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# Your real domain (e.g. "https://energy-shop.ir"), no trailing slash. Needed for SEO —
# canonical URLs, sitemap.xml, and social-share previews all need an absolute site URL.
# In production this is set automatically from the PUBLIC_DOMAIN repo variable; leave blank locally.
NEXT_PUBLIC_SITE_URL=""

# Optional: object storage for product photo uploads (ArvanCloud, S3-compatible).
# Leave all five blank to fall back to local disk (fine for local dev). In production this
# is required — see the "Product photo storage" section in README.md for why.
ARVAN_S3_ENDPOINT=""
ARVAN_S3_BUCKET=""
ARVAN_S3_ACCESS_KEY=""
ARVAN_S3_SECRET_KEY=""
# Public base URL objects are served from — usually https://<bucket>.<endpoint host>,
# or a custom domain if you've pointed one at the bucket.
ARVAN_S3_PUBLIC_URL=""
