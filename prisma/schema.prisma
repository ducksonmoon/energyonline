generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id        String    @id @default(cuid())
  key       String    @unique
  label     String
  iconKey   String
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id            String         @id @default(cuid())
  name          String
  description   String
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  basePrice     Int
  discountPrice Int?
  flashPrice    Int?
  isNew         Boolean        @default(false)
  /// Manually picked for the homepage hero's 2-up product preview. When
  /// fewer than 2 products are featured, the hero fills the rest from the
  /// regular catalog order — see heroProducts in StorefrontApp.tsx.
  featuredInHero Boolean       @default(false)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  images        ProductImage[]
  sizes         ProductSize[]
  sales         Sale[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int     @default(0)

  @@unique([productId, size])
}

/// One in-store sale of a single unit, entered by staff on the sale-entry screen.
/// Selling decrements the matching ProductSize.stock; undoing a sale restores it.
model Sale {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  price     Int
  soldBy    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model StoreSettings {
  id              Int       @id @default(1)
  accentColor     String    @default("#f4c81a")
  gridDensity     String    @default("comfortable")
  showCountdown   Boolean   @default(true)
  discountEndsAt  DateTime?
  address         String    @default("ساری، خیابان فرهنگ")
  /// "باز کردن در گوگل‌مپ" link under the footer's embedded map — a Google
  /// Maps place/share link (short links like maps.app.goo.gl work fine),
  /// opened in a new tab.
  mapUrl          String    @default("https://maps.app.goo.gl/RtA3aCbnWFHJUugn6")
  /// Coordinates the footer's embedded map iframe centers on. Kept separate
  /// from mapUrl because a maps.app.goo.gl short link can't be used directly
  /// as an iframe src (it redirects, and the redirect target blocks framing).
  mapLat          Float     @default(36.560164)
  mapLng          Float     @default(53.063765)
  phone           String    @default("011-33305327")
  /// Landline/mobile for coordinating orders sourced from Turkey (see the "سفارش از ترکیه" section).
  phoneTurkey     String    @default("+90 531 733 2665")
  hoursWeekday    String    @default("۱۰ تا ۲۱")
  hoursThursday   String    @default("۱۰ تا ۱۹")
  hoursFriday     String    @default("تعطیل")
  instagramHandle String    @default("energie_boutique_online")
  telegramHandle  String    @default("energieonline")

  flashSaleEnabled    Boolean   @default(false)
  flashSaleEndsAt     DateTime?
  flashSaleTitle      String    @default("تا ۷۰٪ تخفیف")
  flashSaleSubtitle   String    @default("فقط برای امروز، روی تعداد محدود")
  flashSaleBannerText String    @default("روز تخفیف ویژه انرژی — تا ۷۰٪ تخفیف، فقط امروز")

  /// When true, browsing/cart stay fully usable but the final checkout step
  /// is replaced with salesPausedMessage instead of the Instagram-DM CTA.
  salesPaused        Boolean @default(true)
  salesPausedMessage String  @default("متاسفیم درحال حاضر امکان فروش از طریق سایت وجود ندارد، به زودی مشکل حل می‌شود.\nمی‌توانید سفارش را از طریق پیج ما یا خرید حضوری در فروشگاه انجام بدید.")
}

model AdminUser {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String
}
